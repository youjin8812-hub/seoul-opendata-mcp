# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr 에서 발급)
SEOUL_OPEN_DATA_API_KEY=your_service_key_here

# ─── 원격(HTTP) 배포용 설정 — src/httpServer.ts ───────────────────────────────
# 리스닝 포트 (Fly.io 기본 8080)
PORT=8080
# 설정하면 MCP 엔드포인트에 Authorization: Bearer <토큰> 이 필요해진다.
# 공개 서버는 비워두고 아래 요청 제한으로 보호한다. 특정 인원에게만 열 때만 설정.
MCP_AUTH_TOKEN=

# ─── 공개 운영 시 남용 방지 (토큰 없이 열어둘 때) ─────────────────────────────
# IP당 분당 요청 수 (기본 20, 순간 버스트는 2배)
MCP_RATE_LIMIT_PER_MIN=20
# IP당 하루 요청 수 (기본 200)
MCP_RATE_LIMIT_PER_DAY=200
# 서울 열린데이터광장 API 전역 일일 호출 예산 (기본 900, 한국시간 자정 리셋)
# 개발계정 한도 1,000건 기준. 운영계정(최대 100,000건) 승인 시 상향 가능.
SEOUL_API_DAILY_BUDGET=900
# DNS 리바인딩 방지 — 쉼표로 구분 (예: seoul-opendata-mcp.fly.dev)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
