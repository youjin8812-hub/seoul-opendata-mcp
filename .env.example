# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr 에서 발급)
SEOUL_OPEN_DATA_API_KEY=your_service_key_here

# ─── 원격(HTTP) 배포용 설정 — src/httpServer.ts ───────────────────────────────
# 리스닝 포트 (Fly.io 기본 8080)
PORT=8080
# 설정하면 MCP 엔드포인트에 Authorization: Bearer <토큰> 이 필요해진다 (외부 배포 시 권장)
MCP_AUTH_TOKEN=
# DNS 리바인딩 방지 — 쉼표로 구분 (예: seoul-opendata-mcp.fly.dev)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ─── 호출 제한 (IP당) ─────────────────────────────────────────────────────────
# 인증키 하나를 여러 사용자가 공유하므로, 토큰 없이 공개할 때 이 값이 인증키를 지킨다.
# 0으로 두면 해당 규칙이 꺼진다. 비워두면 기본값(분당 20 / 시간당 200) 적용.
MCP_RATE_LIMIT_PER_MINUTE=20
MCP_RATE_LIMIT_PER_HOUR=200
# 프록시(Fly.io 등) 뒤에서 X-Forwarded-For를 클라이언트 IP로 신뢰할지 여부.
# Fly-Client-IP는 항상 우선 사용되므로 Fly.io에서는 보통 설정할 필요가 없다.
MCP_TRUST_PROXY=
