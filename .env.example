# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr 에서 발급)
SEOUL_OPEN_DATA_API_KEY=your_service_key_here

# ─── 원격(HTTP) 배포용 설정 — src/httpServer.ts ───────────────────────────────
# 리스닝 포트 (Fly.io 기본 8080)
PORT=8080
# 설정하면 MCP 엔드포인트에 Authorization: Bearer <토큰> 이 필요해진다.
# 공개 서버는 비워두고 아래 요청 제한으로 보호한다. 특정 인원에게만 열 때만 설정.
MCP_AUTH_TOKEN=

# ─── 공개 운영 시 서버 보호 (토큰 없이 열어둘 때) ─────────────────────────────
# 참고: 서울 열린데이터광장 일반 오픈API에는 호출 횟수 제한이 없다.
# (1,000건 = 1회 호출당 응답 건수, 1일 1,000회 = 실시간 지하철 API 전용)
# 아래 제한이 지키는 대상은 인증키 한도가 아니라 이 서버가 올라간 머신이다.
# IP당 분당 요청 수 (기본 60, 순간 버스트는 2배)
MCP_RATE_LIMIT_PER_MIN=60
# IP당 하루 요청 수 (기본 2000)
MCP_RATE_LIMIT_PER_DAY=2000
# 상위 API 전역 일일 호출 상한 — 폭주 방지 차단기 (기본 50000, 0이면 해제)
SEOUL_API_DAILY_BUDGET=50000
# DNS 리바인딩 방지 — 쉼표로 구분 (예: seoul-opendata-mcp.fly.dev)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
